@namespace Flowbite.Components.Pagination
@inherits FlowbiteComponentBase
@using Microsoft.AspNetCore.Components

<nav aria-label="Page navigation" class="@GetContainerClasses()">
    <ul class="inline-flex -space-x-px text-sm">
        <!-- Previous Button -->
        @if (ShowPreviousNext)
        {
            <PaginationItem IsPrevious="true"
                            Size="@Size"
                            Disabled="@(CurrentPage <= 1)"
                            OnClick="HandlePreviousClick"
                            Icon="@PreviousIcon">
                @PreviousText
            </PaginationItem>
        }

        <!-- Page Numbers -->
        @if (ChildContent == null)
        {
            @for (int i = 1; i <= TotalPages; i++)
            {
                var pageNumber = i;
                <PaginationItem PageNumber="@pageNumber"
                                Size="@Size"
                                IsActive="@(pageNumber == CurrentPage)"
                                OnClick="@((page) => ChangePage(page))">
                                @pageNumber.ToString()
                    
                </PaginationItem>
            }
        }
        else
        {
            @ChildContent
        }

        <!-- Next Button -->
        @if (ShowPreviousNext)
        {
            <PaginationItem IsNext="true"
                            Disabled="@(CurrentPage >= TotalPages)"
                            Size="@Size"
                            OnClick="HandleNextClick"
                            Icon="@NextIcon">
                @NextText
            </PaginationItem>
        }
    </ul>
</nav>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public int TotalPages { get; set; } = 1;
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public PaginationSize Size { get; set; } = PaginationSize.Medium;
    [Parameter] public PaginationAlignment Alignment { get; set; } = PaginationAlignment.Center;
    [Parameter] public bool ShowPreviousNext { get; set; } = true;
    [Parameter] public string PreviousText { get; set; } = "Previous";
    [Parameter] public string NextText { get; set; } = "Next";
    [Parameter] public object? PreviousIcon { get; set; }
    [Parameter] public object? NextIcon { get; set; }
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }
    [Parameter] public EventCallback<int> CurrentPageChanged { get; set; } 

    private string GetContainerClasses()
    {
        return Alignment switch
        {
            PaginationAlignment.Left => "text-left",
            PaginationAlignment.Right => "text-right",
            _ => "text-center"
        };
    }

    private async Task ChangePage(int? pageNumber)
    {
        if (!pageNumber.HasValue || pageNumber < 1 || pageNumber > TotalPages)
            return;

        CurrentPage = pageNumber.Value;

        await CurrentPageChanged.InvokeAsync(CurrentPage);
        await OnPageChanged.InvokeAsync(CurrentPage);
    }

    private async Task HandlePreviousClick(int? page)
    {
        if (CurrentPage > 1)
            await ChangePage(CurrentPage - 1);
    }

    private async Task HandleNextClick(int? page)
    {
        if (CurrentPage < TotalPages)
            await ChangePage(CurrentPage + 1);
    }
}